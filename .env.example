# Copy to .env.local. Never commit .env.local.
# Every value here is a secret or an environment-specific ID.

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://amhwellness.co.uk"

# ── Semble (booking + clinical records) ──────────────────────────────────────
# Semble is the system of record for appointments. The website never stores
# patient clinical data — it hands off. See docs/06-integrations.md.
SEMBLE_API_KEY=""
SEMBLE_BOOKING_URL=""

# ── Stripe (consultation booking fee) ────────────────────────────────────────
# Direct Stripe is intentionally disabled. Semble-hosted pre-payment is the
# current strategy. Only configure these if Akila explicitly changes it.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Enquiry delivery ─────────────────────────────────────────────────────────
# Resend transactional email for callback/contact requests. The from address
# must use a domain verified in Resend. No free-text message is sent by email.
RESEND_API_KEY=""
ENQUIRY_FROM_ADDRESS=""
ENQUIRY_TO_ADDRESS="admin@amhwellness.co.uk"

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 for Search Console linkage. Cookie consent required before it loads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
